# ============================================
# Whisper API - Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
#
# Ou rode o setup interativo:
#   python setup.py
# ============================================

# --- Evolution API ---
# URL base da sua instância da Evolution API (sem barra no final)
EVOLUTION_API_URL=http://localhost:8080

# API Key global do servidor Evolution (definida no .env do servidor Evolution)
EVOLUTION_API_GLOBAL_KEY=sua_global_api_key_aqui

# API Key da instância (gerada ao criar a instância, campo "hash")
EVOLUTION_API_KEY=sua_instance_api_key_aqui

# Nome da instância no Evolution API
EVOLUTION_INSTANCE=whisper-bot

# --- WhatsApp ---
# Número que vai RECEBER as transcrições (com DDI, sem +, sem espaços)
# Exemplo: 5511999999999
NUMERO_DESTINO=5511999999999

# --- Webhook ---
# URL pública do seu servidor FastAPI (onde a Evolution API vai enviar os eventos)
# Exemplo: http://minha-vps.com:8000 ou http://localhost:8000
WEBHOOK_URL=http://localhost:8000

# Token secreto para autenticar as requisições do webhook
# O setup.py gera um automaticamente, ou defina o seu
WEBHOOK_TOKEN=seu_token_secreto_aqui

# --- Email (Gmail SMTP) ---
# Senha de app do Google para envio de emails (funcionalidade de transcrição por email)
# Gere em: https://myaccount.google.com/apppasswords
APP_SENHA_GOOGLE=sua_senha_de_app_aqui
